<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20">
            <!-- Add Controls for Previewer Here -->
        </Border>
    </Design.PreviewWith>

    <!-- GameListView Toolbar Section Buttons -->
    <Style Selector="Button.toolbar-btn">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.toolbar-btn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource GameListHover}" />
    </Style>
    <Style Selector="Button.toolbar-btn:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource GameListSelection}" />
    </Style>

    <!-- ModView Game Card buttons -->
    <Style Selector="Button.toolbar-btn TextBlock.spinning">
        <Style.Animations>
            <Animation Duration="0:0:1" IterationCount="Infinite">
                <KeyFrame Cue="0%">
                    <Setter Property="RotateTransform.Angle" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="RotateTransform.Angle" Value="360" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Button.game-card-btn">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="{DynamicResource ModCardButton}" />
        <Setter Property="Foreground" Value="{DynamicResource ModCardButtonText}" />
    </Style>
    <Style Selector="Button.game-card-btn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ModCardButtonHover}" />
    </Style>
    <Style Selector="Button.game-card-btn:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource GameListSelection}" />
    </Style>
    <Style Selector="Button.game-card-btn:disabled">
        <Setter Property="Opacity" Value="0.35" />
    </Style>


    <!-- ModView Mod buttons -->
    <Style Selector="Button.mod-card-btn">
        <Setter Property="Background" Value="{DynamicResource ModCardButton}" />
        <Setter Property="Foreground" Value="{DynamicResource ModCardButtonText}" />
    </Style>
    <Style Selector="Button.mod-card-btn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ModCardButtonHover}" />
    </Style>
    <Style Selector="Button.mod-card-btn:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource GameListSelection}" />
    </Style>
    <Style Selector="Button.mod-card-btn:disabled">
        <Setter Property="Opacity" Value="0.35" />
    </Style>

</Styles>
