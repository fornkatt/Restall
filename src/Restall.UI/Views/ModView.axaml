<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Restall.UI.ViewModels"
             xmlns:renodx="clr-namespace:Restall.Application.DTOs.RenoDXDTOs;assembly=Restall.Application"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Restall.UI.Views.ModView"
             x:DataType="vm:ModViewModel">

    <UserControl.Resources>
        <Flyout x:Key="RenoDXNoticesFlyout" Placement="Top">
            <ItemsControl ItemsSource="{Binding SelectedGame.RenoDXEntry.Notices}"
                          MaxWidth="380">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{Binding}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Margin="0, 4" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Flyout>
    </UserControl.Resources>

    <!-- TODO(UI improvement branch): extract magic hex code values and add as DynamicResource or similar -->

    <Grid ColumnDefinitions="*"
          RowDefinitions="Auto,*">

        <!-- GAME CARD -->
        <Border Grid.Row="0" CornerRadius="20" Margin="5" Background="{DynamicResource GameCardBackground}">
            <Grid ColumnDefinitions="Auto,*">

                <!--- GAME COVER -->
                <Border Grid.Column="0" CornerRadius="6" Margin="10" ClipToBounds="True"
                        Width="200" Height="280"
                        VerticalAlignment="Top">
                    <Image Source="{Binding SelectedGame.CoverBitmap}"
                           Stretch="UniformToFill"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center" />
                </Border>

                <!--- GAME INFO -->
                <Grid Grid.Column="1"
                      ColumnDefinitions="*"
                      RowDefinitions="Auto,Auto,Auto,Auto, Auto"
                      Margin="8"
                      VerticalAlignment="Top">

                    <!--TODO: ADD ANIMATION FOR RELAYCOMMAND -->
                    <Grid Grid.Column="0" ColumnDefinitions="*, Auto"
                          VerticalAlignment="Center">

                        <TextBlock Grid.Column="0"
                                   Text="{Binding SelectedGame.Name}"
                                   FontSize="20"
                                   FontWeight="Bold" Padding="6,0,0,0"
                                   Foreground="{DynamicResource GameCardText}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Classes="game-card-btn"
                                CornerRadius="6"
                                Margin="6,0">
                            <TextBlock FontFamily="{StaticResource Phosphor-Fill}"
                                       FontSize="16"
                                       Text="&#xE094;" />
                        </Button>

                    </Grid>


                    <TextBlock Grid.Row="1" Text="{Binding SelectedGame.PlatformName}"
                               FontSize="12" Foreground="{DynamicResource GameCardText}"
                               Padding="6,0,0,0" />

                    <TextBlock Grid.Row="2" Text="{Binding SelectedGame.EngineName}"
                               FontSize="12"
                               Foreground="{DynamicResource GameCardText}"
                               Padding="6,0,0,0" />

                    <Button Classes="game-card-btn"
                            Grid.Row="3"
                            Command="{Binding OpenInExplorerCommand}"
                            CommandParameter="{Binding SelectedGame.InstallFolder}"
                            CornerRadius="2"
                            Background="{DynamicResource ModCardButton}"
                            BorderThickness="0"
                            Padding="0"
                            HorizontalContentAlignment="Left"
                            Margin="0,6,0,0">
                        <TextBlock
                            Text="{Binding SelectedGame.InstallFolderDisplay}"
                            FontSize="12" Foreground="{DynamicResource ModCardButtonText}"
                            Opacity="0.8"
                            Padding="6,4"
                            TextWrapping="Wrap" />
                    </Button>

                    <Button Classes="game-card-btn"
                            Grid.Row="4"
                            Command="{Binding OpenInExplorerCommand}"
                            CommandParameter="{Binding SelectedGame.ExecutablePath}"
                            CornerRadius="2"
                            Background="{DynamicResource ModCardButton}"
                            BorderThickness="0"
                            Padding="0"
                            HorizontalContentAlignment="Left"
                            Margin="0,6,0,0">
                        <TextBlock
                            Text="{Binding SelectedGame.ExecutablePathDisplay}"
                            FontSize="12" Foreground="{DynamicResource ModCardButtonText}"
                            Opacity="0.8"
                            Padding="6,4"
                            TextWrapping="Wrap" />
                    </Button>

                </Grid>
            </Grid>
        </Border>
        <!-- MOD CARD -->
        <Border Grid.Row="1" Margin="5" CornerRadius="20" Background="{DynamicResource GameCardBackground}">
            <Grid RowDefinitions="Auto, Auto"
                  ColumnDefinitions="0.5*, 0.5*"
                  Grid.IsSharedSizeScope="True">

                <!-- RESHADE -->
                <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                      ColumnDefinitions="0.5*, 0.5*"
                      RowDefinitions="Auto, Auto, Auto, Auto, Auto"
                      Margin="10">
                    <Grid Grid.Row="0" Grid.Column="0"
                          ColumnDefinitions="0.75*, 0.25*">
                        <Grid Grid.Column="0"
                              Grid.ColumnSpan="2"
                              RowDefinitions="Auto, Auto, Auto, Auto">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="ModTitle" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="ReShade" FontWeight="Bold" FontSize="28"
                                       Foreground="{DynamicResource GameCardText}" />
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="Not installed"
                                       FontSize="16"
                                       TextTrimming="CharacterEllipsis"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Margin="5, 0"
                                       Foreground="{DynamicResource GameCardText}"
                                       IsVisible="{Binding !SelectedGame.HasReShade}" />
                            <StackPanel Grid.Row="0" Grid.Column="1"
                                        Margin="5"
                                        HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding SelectedGame.ReShadeFilename}" FontSize="10"
                                               Foreground="{DynamicResource GameCardText}" />
                                    <TextBlock Text="{Binding SelectedGame.ReShadeArch}" FontSize="10"
                                               Foreground="{DynamicResource GameCardText}"
                                               Margin="5, 0, 0, 0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding SelectedGame.ReShadeBranch}" FontSize="10"
                                               Foreground="{DynamicResource GameCardText}" />
                                    <TextBlock Text=" | " FontSize="10"
                                               Foreground="{DynamicResource GameCardText}"
                                               IsVisible="{Binding SelectedGame.HasReShade}" />
                                    <TextBlock Text="{Binding SelectedGame.ReShadeVersion}" FontSize="10"
                                               Foreground="{Binding ReShadeVersionTextColor}" />
                                    <TextBlock Text=" -> " FontSize="10" Foreground="{DynamicResource GameCardText}"
                                               IsVisible="{Binding CanShowReShadeUpdate}" />
                                    <TextBlock Text="{Binding ReShadeLatestVersionForBranch}" FontSize="10"
                                               Foreground="#1ab652"
                                               IsVisible="{Binding CanShowReShadeUpdate}" />
                                </StackPanel>
                            </StackPanel>
                            <Button Classes="mod-card-btn"
                                    Grid.Column="0" Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Content="{Binding InstallReShadeButtonText}"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    HorizontalAlignment="Stretch"
                                    CornerRadius="6"
                                    Command="{Binding InstallReShadeCommand}"
                                    Background="{DynamicResource ModCardButton}"
                                    Foreground="{DynamicResource ModCardButtonText}"
                                    Margin="0, 5, 5, 5" />
                            <Button Classes="mod-card-btn"
                                    Grid.Column="0" Grid.Row="2"
                                    Grid.ColumnSpan="2"
                                    Content="{Binding UpdateReShadeButtonText}"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    HorizontalAlignment="Stretch"
                                    CornerRadius="6"
                                    Command="{Binding UpdateReShadeCommand}"
                                    Background="{DynamicResource ModCardButton}"
                                    Foreground="{DynamicResource ModCardButtonText}"
                                    Margin="0, 5, 5, 5" />
                            <Button Classes="mod-card-btn"
                                    Grid.Column="0" Grid.Row="3"
                                    Grid.ColumnSpan="2"
                                    Content="{Binding UninstallReShadeButtonText}"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    HorizontalAlignment="Stretch"
                                    CornerRadius="6"
                                    Command="{Binding UninstallReShadeCommand}"
                                    Background="{DynamicResource ModCardButton}"
                                    Foreground="{DynamicResource ModCardButtonText}"
                                    Margin="0, 5, 5, 5" />
                        </Grid>
                    </Grid>
                </Grid>

                <Border Grid.Column="1"
                        Grid.Row="0"
                        CornerRadius="10"
                        Margin="10"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource GameCardNotesBorder}"
                        ClipToBounds="True"
                        VerticalAlignment="Top"
                        MaxHeight="100"
                        IsVisible="{Binding SelectedGame.IsShowingReShadeActionMessage}">

                    <TextBlock TextWrapping="Wrap"
                               FontSize="12"
                               Margin="10"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               Foreground="{DynamicResource GameCardText}"
                               Text="{Binding SelectedGame.ReShadeModActionStatus}" />
                </Border>

                <!-- RENODX -->
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Top"
                            IsVisible="{Binding !SelectedGame.RenoDXEntry.IsSupported}">
                    <TextBlock Text="RenoDX not supported"
                               FontWeight="Bold"
                               FontSize="28"
                               Foreground="{DynamicResource GameCardText}"
                               Margin="10, 10, 0, 0" />
                    <Button Classes="game-card-btn notice-btn"
                            Classes.unseen="{Binding SelectedGame.HasUnseenRenoDXNotices}"
                            IsVisible="{Binding !SelectedGame.RenoDXEntry.Notices.IsEmpty}"
                            Command="{Binding SelectedGame.MarkRenoDXNoticesSeenCommand}"
                            Flyout="{StaticResource RenoDXNoticesFlyout}"
                            CornerRadius="6"
                            Padding="6, 2"
                            Margin="5, 10, 0, 0"
                            ToolTip.Tip="Notices">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource Phosphor-Fill}"
                                       FontSize="16"
                                       Text="&#xE4E0;"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SelectedGame.RenoDXEntry.Notices.Length}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding SelectedGame.HasUnseenRenoDXNotices}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                      ColumnDefinitions="0.5*, 0.5*"
                      RowDefinitions="Auto, Auto, Auto, Auto, Auto"
                      Margin="10"
                      IsVisible="{Binding SelectedGame.RenoDXEntry.IsSupported}">
                    <Grid Grid.Row="0" Grid.Column="0"
                          ColumnDefinitions="0.75*, 0.25*">
                        <Grid Grid.Column="0"
                              Grid.ColumnSpan="2"
                              RowDefinitions="Auto, Auto, Auto, Auto, Auto">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="ModTitle" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="RenoDX" FontWeight="Bold" FontSize="28"
                                       Foreground="{DynamicResource GameCardText}" />
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="Not installed"
                                       FontSize="16"
                                       TextTrimming="CharacterEllipsis"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Margin="5, 0"
                                       Foreground="{DynamicResource GameCardText}"
                                       IsVisible="{Binding !SelectedGame.HasRenoDX}" />
                            <StackPanel Grid.Row="0" Grid.Column="1"
                                        Margin="5, 0"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding SelectedGame.HasRenoDX}">
                                <TextBlock Text="{Binding SelectedGame.RenoDXName}"
                                           FontSize="10"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource GameCardText}" />
                                <TextBlock FontSize="10"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource GameCardText}">
                                    <Run Text="{Binding SelectedGame.RenoDXBranch}" />
                                    <Run Text="|" />
                                    <Run Text="{Binding SelectedGame.RenoDXVersion}"
                                         Foreground="{Binding RenoDXVersionTextColor}" />
                                    <Run Text="{Binding RenoDXUpdateArrowText}"
                                         Foreground="#1ab652" />
                                </TextBlock>
                            </StackPanel>

                            <Button Grid.Row="0" Grid.Column="2" Classes="game-card-btn notice-btn"
                                    Classes.unseen="{Binding SelectedGame.HasUnseenRenoDXNotices}"
                                    IsVisible="{Binding !SelectedGame.RenoDXEntry.Notices.IsEmpty}"
                                    Command="{Binding SelectedGame.MarkRenoDXNoticesSeenCommand}"
                                    Flyout="{StaticResource RenoDXNoticesFlyout}"
                                    CornerRadius="6"
                                    Padding="6, 2"
                                    Margin="0, 5, 5, 5"
                                    ToolTip.Tip="Notices">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource Phosphor-Fill}"
                                               FontSize="16"
                                               Text="&#xE4E0;"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding SelectedGame.RenoDXEntry.Notices.Length}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding SelectedGame.HasUnseenRenoDXNotices}" />
                                </StackPanel>
                            </Button>

                            <Button Classes="mod-card-btn"
                                    Grid.Column="0" Grid.Row="1"
                                    Grid.ColumnSpan="3"
                                    Content="{Binding SelectedGame.InstallRenoDXButtonText}"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    HorizontalAlignment="Stretch"
                                    CornerRadius="6"
                                    Command="{Binding RenoDXInstallButtonClickCommand}"
                                    Background="{DynamicResource ModCardButton}"
                                    Foreground="{DynamicResource ModCardButtonText}"
                                    Margin="0, 5, 5, 5" />
                            <Button Classes="mod-card-btn"
                                    Grid.Column="0" Grid.Row="2"
                                    Grid.ColumnSpan="3"
                                    Content="{Binding SelectedGame.UpdateRenoDXButtonText}"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    HorizontalAlignment="Stretch"
                                    CornerRadius="6"
                                    Command="{Binding UpdateRenoDXCommand}"
                                    Background="{DynamicResource ModCardButton}"
                                    Foreground="{DynamicResource ModCardButtonText}"
                                    Margin="0, 5, 5, 5" />
                            <Button Classes="mod-card-btn"
                                    Grid.Column="0" Grid.Row="3"
                                    Grid.ColumnSpan="3"
                                    Content="{Binding SelectedGame.UninstallRenoDXButtonText}"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    HorizontalAlignment="Stretch"
                                    CornerRadius="6"
                                    Command="{Binding UninstallRenoDXCommand}"
                                    Background="{DynamicResource ModCardButton}"
                                    Foreground="{DynamicResource ModCardButtonText}"
                                    Margin="0, 5, 5, 5" />
                            <Grid Grid.Column="0" Grid.Row="4"
                                  Grid.ColumnSpan="3"
                                  ColumnDefinitions="0.5*, Auto, *"
                                  Margin="5">
                                <ComboBox Grid.Column="0"
                                          IsVisible="{Binding CanShowRenoDXBranchSelector}"
                                          VerticalAlignment="Top"
                                          ItemsSource="{Binding AvailableRenoDXBranches}"
                                          SelectedItem="{Binding SelectedRenoDXBranch, Mode=TwoWay}"
                                          FontSize="12"
                                          FontWeight="SemiBold"
                                          Foreground="{DynamicResource GameCardText}"
                                          Margin="0"
                                          Padding="10, 5, 5, 5"
                                          CornerRadius="6">
                                    <ToolTip.Tip>
                                        <StackPanel MaxWidth="320" Spacing="8">
                                            <TextBlock TextWrapping="Wrap"
                                                       Text="Select the branch to use for RenoDX downloads."
                                                       FontWeight="ExtraBold" />
                                            <TextBlock TextWrapping="Wrap">
                                                <Bold>Snapshot:</Bold> Default. Prefer using this branch.
                                            </TextBlock>
                                            <TextBlock TextWrapping="Wrap">
                                                <Bold>Nightly:</Bold> Select this branch to rollback if latest Snapshot
                                                is causing issues.
                                            </TextBlock>
                                            <TextBlock TextWrapping="Wrap">
                                                <Bold>Direct:</Bold> Downloads the file from the mod's own download
                                                link, usually the mod author's GitHub page.
                                            </TextBlock>
                                        </StackPanel>
                                    </ToolTip.Tip>
                                </ComboBox>
                                <Button Grid.Column="1"
                                        Classes="game-card-btn"
                                        Margin="5, 0, 0, 0"
                                        VerticalAlignment="Center"
                                        CornerRadius="6"
                                        Padding="6, 2"
                                        IsVisible="{Binding HasSelectedRenoDXReleaseNotes}"
                                        ToolTip.Tip="Release notes">
                                    <Button.Flyout>
                                        <Flyout Placement="Top">
                                            <ScrollViewer MaxWidth="400" MaxHeight="300">
                                                <ItemsControl ItemsSource="{Binding SelectedRenoDXReleaseNotes}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="renodx:RenoDXReleaseNotes">
                                                            <StackPanel Margin="0, 0, 0, 10" Spacing="2">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <TextBlock Text="{Binding Version}"
                                                                               FontSize="12"
                                                                               FontWeight="Bold" />
                                                                    <TextBlock Text="Latest"
                                                                               FontSize="11"
                                                                               Opacity="0.7"
                                                                               IsVisible="{Binding IsLatest}" />
                                                                    <TextBlock Text="Installed"
                                                                               FontSize="11"
                                                                               Foreground="#1ab652"
                                                                               IsVisible="{Binding IsInstalled}" />
                                                                </StackPanel>
                                                                <TextBlock Text="No notes for this release."
                                                                           FontSize="11"
                                                                           Opacity="0.7"
                                                                           IsVisible="{Binding Lines.IsEmpty}" />
                                                                <ItemsControl ItemsSource="{Binding Lines}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="x:String">
                                                                            <TextBlock Text="{Binding}"
                                                                                    FontSize="11"
                                                                                    TextWrapping="Wrap" />
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Flyout>
                                    </Button.Flyout>
                                    <TextBlock FontFamily="{StaticResource Phosphor-Fill}"
                                               FontSize="16"
                                               Text="&#xE63E;"
                                               VerticalAlignment="Center" />
                                </Button>
                                <TextBlock Grid.Column="2"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Foreground="{DynamicResource GameCardText}"
                                           Opacity="0.7"
                                           Margin="5"
                                           IsVisible="{Binding IsRenoDXUpdateCheckUnavailable}"
                                           Text="{Binding RenoDXUpdateCheckUnavailableText}" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
                <Border Grid.Column="1"
                        Grid.Row="1"
                        CornerRadius="10"
                        Margin="10"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource GameCardNotesBorder}"
                        ClipToBounds="True"
                        VerticalAlignment="Top"
                        MaxHeight="150"
                        IsVisible="{Binding SelectedGame.IsRenoDXInfoBoxVisible}">
                    <Grid>
                        <Grid ColumnDefinitions="*, Auto"
                              IsVisible="{Binding !SelectedGame.IsShowingRenoDXMessage}">
                            <Grid Grid.Column="0" RowDefinitions="Auto, *">
                                <StackPanel Grid.Row="0" Margin="10" Spacing="6">
                                    <Grid ColumnDefinitions="*, Auto"
                                          HorizontalAlignment="Left">
                                        <TextBlock
                                            Grid.Column="0"
                                            Text="{Binding SelectedGame.RenoDXEntry.HeadingText}"
                                            ToolTip.Tip="{Binding SelectedGame.RenoDXEntry.HeadingText}"
                                            IsVisible="{Binding SelectedGame.RenoDXEntry.HeadingText,
                                            Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                            TextWrapping="Wrap"
                                            MaxLines="2"
                                            TextTrimming="CharacterEllipsis"
                                            FontSize="11"
                                            Opacity="0.6"
                                            Foreground="{DynamicResource GameCardText}"
                                            VerticalAlignment="Center" />
                                        <Button
                                            Grid.Column="1"
                                            Classes="game-card-btn"
                                            IsVisible="{Binding SelectedGame.RenoDXEntry.GenericAddonInfo,
                                            Converter={x:Static ObjectConverters.IsNotNull}}"
                                            CornerRadius="6"
                                            Margin="4, 0, 0, 0"
                                            Padding="6, 2"
                                            ToolTip.Tip="About this generic mod"
                                            VerticalAlignment="Center">
                                            <Button.Flyout>
                                                <Flyout Placement="Top">
                                                    <StackPanel
                                                        MaxWidth="420"
                                                        Spacing="6"
                                                        DataContext="{Binding SelectedGame.RenoDXEntry.GenericAddonInfo}">
                                                        <TextBlock
                                                            Text="{Binding Name}"
                                                            FontWeight="Bold"
                                                            FontSize="14" />
                                                        <TextBlock
                                                            Text="{Binding Author,
                                                     StringFormat='by {0}'}"
                                                            FontSize="12"
                                                            Opacity="0.7" />
                                                        <TextBlock
                                                            Text="{Binding Notes}"
                                                            TextWrapping="Wrap"
                                                            FontSize="12" />
                                                        <Border
                                                            IsVisible="{Binding EngineIni,
                                                     Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                            Background="{DynamicResource AppBackground}"
                                                            CornerRadius="4"
                                                            Padding="6">
                                                            <SelectableTextBlock
                                                                Text="{Binding EngineIni}"
                                                                FontFamily="Cascadia Code,Consolas,monospace"
                                                                FontSize="11"
                                                                TextWrapping="Wrap" />
                                                        </Border>
                                                    </StackPanel>
                                                </Flyout>
                                            </Button.Flyout>
                                            <TextBlock FontFamily="{StaticResource Phosphor-Fill}"
                                                       FontSize="16"
                                                       Text="&#xE3E8;"
                                                       VerticalAlignment="Center" />
                                        </Button>
                                    </Grid>
                                    <TextBlock
                                        Text="{Binding SelectedGame.RenoDXEntry.Author, StringFormat='by {0}'}"
                                        IsVisible="{Binding SelectedGame.RenoDXEntry.Author,
                                     Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                        TextWrapping="Wrap"
                                        FontSize="12"
                                        Foreground="{DynamicResource GameCardText}" />
                                </StackPanel>
                                <ScrollViewer Grid.Row="1"
                                              Margin="10"
                                              VerticalAlignment="Top">
                                    <StackPanel Spacing="6">
                                        <TextBlock
                                            Text="{Binding SelectedGame.RenoDXEntry.DatabaseNotes}"
                                            IsVisible="{Binding SelectedGame.RenoDXEntry.DatabaseNotes,
                                     Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                            TextWrapping="Wrap"
                                            FontSize="12"
                                            Foreground="{DynamicResource GameCardText}" />
                                        <TextBlock
                                            Text="{Binding SelectedGame.RenoDXEntry.UnrealMethodText}"
                                            IsVisible="{Binding SelectedGame.RenoDXEntry.UnrealMethodText,
                                     Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                            TextWrapping="Wrap"
                                            FontSize="12"
                                            Foreground="{DynamicResource GameCardText}" />
                                        <ItemsControl ItemsSource="{Binding SelectedGame.RenoDXEntry.Upgrades}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <Border Background="{DynamicResource AppBackground}"
                                                            CornerRadius="4"
                                                            Padding="6, 2"
                                                            Margin="0, 0, 4, 4">
                                                        <SelectableTextBlock
                                                            Text="{Binding}"
                                                            FontFamily="Cascadia Code,Consolas,monospace"
                                                            FontSize="11"
                                                            Foreground="{DynamicResource GameCardText}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                            <StackPanel Grid.Column="1"
                                        Margin="5"
                                        Spacing="6">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Spacing="6">
                                    <Panel Width="30"
                                           Margin="0, 0, 6, 0"
                                           VerticalAlignment="Center"
                                           Background="Transparent"
                                           ToolTip.Tip="{Binding SelectedGame.RenoDXEntry.StatusText}">
                                        <TextBlock FontFamily="{StaticResource Phosphor-Fill}"
                                                   FontSize="30"
                                                   Text="&#xE184;"
                                                   Foreground="#1ab652"
                                                   IsVisible="{Binding SelectedGame.RenoDXEntry.IsDone}" />
                                        <TextBlock FontFamily="{StaticResource Phosphor-Fill}"
                                                   FontSize="30"
                                                   Text="&#xE948;"
                                                   Foreground="#eb5a2f"
                                                   IsVisible="{Binding SelectedGame.RenoDXEntry.IsWorkInProgress}" />
                                    </Panel>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding SelectedGame.RenoDXEntry.Links}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="renodx:RenoDXModLink">
                                            <HyperlinkButton Content="{Binding Label}"
                                                             Command="{Binding $parent[ItemsControl].((vm:ModViewModel)DataContext).OpenWebLinkCommand}"
                                                             CommandParameter="{Binding Url}"
                                                             ToolTip.Tip="{Binding Url}"
                                                             FontSize="12"
                                                             Padding="0"
                                                             Margin="0, 0, 12, 0" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>

                        <TextBlock TextWrapping="Wrap"
                                   FontSize="12"
                                   Margin="10"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"
                                   Foreground="{DynamicResource GameCardText}"
                                   IsVisible="{Binding SelectedGame.IsShowingRenoDXMessage}"
                                   Text="{Binding SelectedGame.RenoDXMessage}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
