<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Restall.UI.ViewModels"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Restall.UI.Views.GameListView"
             x:DataType="vm:GameListViewModel">


    <Grid RowDefinitions="Auto, *">
        <Border Grid.Row="0"
                Background="{DynamicResource GameCardBackground}"
                CornerRadius="6"
                Padding="4"
                Margin="8,6,8,0"
                ClipToBounds="True">
            <Grid RowDefinitions="Auto, Auto">

                <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*">
                    <Button Grid.Column="0" Classes="toolbar-btn"
                            Command="{Binding FullRefreshLibraryCommand}"
                            BorderThickness="0"
                            CornerRadius="6"
                            Padding="8,6"
                            Margin="8,6">
                        <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                            <TextBlock FontFamily="{StaticResource Phosphor-Fill}" FontSize="24"
                                       Text="&#xE758;"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Full Rescan"
                                       Margin="10,0,4,0"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Classes="toolbar-btn"
                            Command="{Binding AddCustomFolderCommand}"
                            ToolTip.Tip="Add custom game folder"
                            BorderThickness="0"
                            CornerRadius="6"
                            Padding="8,6"
                            Margin="0,6">
                        <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                            <TextBlock FontFamily="{StaticResource Phosphor-Fill}" FontSize="24"
                                       Text="&#xE258;"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
                <Border Grid.Row="1"
                        Height="28"
                        HorizontalAlignment="Stretch">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock
                            Text="{Binding ScanMessage}"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource GameCardText}"
                            VerticalAlignment="Center"
                            Margin="8,2,4,4" />
                        <Button Grid.Column="1"
                                Classes="toolbar-btn notice-btn"
                                Classes.unseen="{Binding HasUnseenRefreshWarnings}"
                                IsVisible="{Binding HasRefreshWarnings}"
                                Command="{Binding MarkRefreshWarningsSeenCommand}"
                                BorderThickness="0"
                                CornerRadius="6"
                                Padding="6, 0"
                                Margin="0, 0, 4, 0"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Refresh warnings">
                            <Button.Flyout>
                                <Flyout>
                                    <ItemsControl ItemsSource="{Binding RefreshWarnings}"
                                                  MaxWidth="380">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="sys:String">
                                                <TextBlock Text="{Binding}"
                                                           TextWrapping="Wrap"
                                                           FontSize="12"
                                                           Margin="0, 4" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Flyout>
                            </Button.Flyout>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock FontFamily="{StaticResource Phosphor-Fill}"
                                           FontSize="14"
                                           Text="&#xE4E0;"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding RefreshWarningCount}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding HasUnseenRefreshWarnings}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- GAME LIST SECTION -->
        <ListBox Grid.Row="1" ItemsSource="{Binding Games}"
                 x:Name="GameList"
                 Classes="game-list"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectedItem="{Binding SelectedGame}"
                 CornerRadius="6"
                 Margin="8,6"
                 MaxWidth="350"
                 Background="{DynamicResource GameCardBackground}"
                 Foreground="{DynamicResource GameCardText}"
                 FontWeight="SemiBold">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Classes="game-list-card"
                            BorderThickness="1"
                            CornerRadius="2"
                            Padding="8, 6"
                            Margin="4, 3">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center">

                            <Border Width="24"
                                    Height="24"
                                    CornerRadius="4"
                                    ClipToBounds="True">
                                <Image Source="{Binding ThumbnailBitmap}"
                                       Stretch="UniformToFill" />
                            </Border>
                            <TextBlock Text="{Binding Name}"
                                       TextTrimming="CharacterEllipsis"
                                       Width="200"
                                       FontSize="12"
                                       Foreground="{DynamicResource GameCardText}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>

</UserControl>
